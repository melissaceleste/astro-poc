---
interface Props {
	href: string;
	variant?: 'primary' | 'secondary';
	icon?: 'arrow-forward';
	iconPosition?: 'left' | 'right';
}

const { href, variant = 'primary', icon, iconPosition = 'right' } = Astro.props;
---

<a href={href} class:list={['button', variant]}>
	{icon && iconPosition === 'left' && <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M12 4l-1.41 1.41L16.17 11H4v2h12.17l-5.58 5.59L12 20l8-8z" /></svg>}
	<slot />
	{icon && iconPosition === 'right' && <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M12 4l-1.41 1.41L16.17 11H4v2h12.17l-5.58 5.59L12 20l8-8z" /></svg>}
</a>

<style>
	.button {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.75rem 1.25rem;
		border: 2px solid #0b3d91;
		border-radius: 4px;
		font-weight: 600;
		text-decoration: none;
	}
	.primary {
		background: #0b3d91;
		color: #fff;
	}
	.secondary {
		background: transparent;
		color: #0b3d91;
	}
	.button:focus-visible {
		outline: 3px solid #f5a623;
		outline-offset: 2px;
	}
	svg {
		width: 1.25em;
		height: 1.25em;
		fill: currentColor;
	}
</style>
